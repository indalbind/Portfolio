# Formspree form endpoint for the contact form.
# Get it from https://formspree.io -> your form -> Integration -> HTML.
# NOTE: must also be added in Vercel -> Project -> Settings -> Environment
# Variables, otherwise the production build falls back to the default in
# src/data/portfolio.js.
VITE_FORMSPREE_ENDPOINT="https://formspree.io/f/xxxxxxxx"
